# 页面标题
VITE_APP_TITLE = MT管理系统

# 开发环境配置
VITE_APP_ENV = 'development'

# MT管理系统/开发环境
VITE_APP_BASE_API = '/dev-api'

# 播放器地址(maic-player-next 部署在子路径 /player/,见 vite.config.ts base)
VITE_PLAYER_URL = 'http://localhost:5173/player'
# VITE_PLAYER_URL = 'http://10.2.2.33:5173/player'

# 后端目标：true=本地网关(localhost:8080)，false=线上nginx(test.www.poroseye.cn)
# 切换后需重启 npm run dev
VITE_API_LOCAL = true

# 🔥 WebSocket 后端地址配置
# 用于开发环境连接 WebSocket 服务
# 选项1：连接本地后端（用于本地全栈调试）
VITE_WS_HOST = localhost
# 选项2：连接远程测试服务器
# VITE_WS_HOST = 182.92.215.114
# 选项3：连接自定义域名
# VITE_WS_HOST = test.www.poroseye.cn
